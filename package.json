{
    "name": "@creeperkatze/modrinth-extras",
    "version": "1.6.8",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox",
        "build": "wxt build",
        "build:firefox": "wxt build -b firefox",
        "zip": "wxt zip",
        "zip:firefox": "wxt zip -b firefox",
        "postinstall": "wxt prepare",
        "scripts": "node scripts/run.mjs",
        "intl:generate": "node scripts/run.mjs generate-locales",
        "intl:extract": "formatjs extract \"src/entrypoints/**/*.{vue,ts}\" --ignore \"src/**/*.d.ts\" --out-file src/locales/en-US/popup.json --preserve-whitespace && formatjs extract \"src/components/**/*.vue\" --ignore \"src/**/*.d.ts\" --out-file src/locales/en-US/components.json --preserve-whitespace",
        "lint": "eslint src/ website/",
        "lint:fix": "eslint src/ website/ --fix",
        "release:patch": "pnpm version patch && git push && git push --tags",
        "release:minor": "pnpm version minor && git push && git push --tags",
        "release:major": "pnpm version major && git push && git push --tags"
    },
    "dependencies": {
        "@lucide/vue": "^1.46.0",
        "@modrinth/api-client": "workspace:*",
        "@modrinth/assets": "workspace:*",
        "@modrinth/ui": "workspace:*",
        "@modrinth/utils": "workspace:*",
        "@wxt-dev/storage": "^1.2.9",
        "curseforge-js": "^1.1.4",
        "d3-force": "^3.0.0",
        "d3-selection": "^3.0.0",
        "d3-transition": "^3.0.1",
        "d3-zoom": "^3.0.0",
        "floating-vue": "^5.4.0",
        "hangarmc-js": "^1.0.4",
        "posthog-js": "^1.431.2",
        "spiget-js": "^1.0.3",
        "vue": "^3.5.42",
        "vue-i18n": "^11.4.10"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@formatjs/cli": "^6.16.27",
        "@modrinth/tooling-config": "workspace:*",
        "@tailwindcss/container-queries": "^0.1.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/chrome": "^0.2.9",
        "@types/d3-force": "^3.0.10",
        "@types/d3-selection": "^3.0.11",
        "@types/d3-transition": "^3.0.9",
        "@types/d3-zoom": "^3.0.8",
        "@types/node": "^26.5.1",
        "@wxt-dev/module-vue": "^1.0.3",
        "autoprefixer": "^10.6.0",
        "eslint": "^10.10.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-vue": "^10.11.0",
        "globals": "^17.12.0",
        "sass-embedded": "^1.104.1",
        "tailwindcss": "^3.4.19",
        "tsx": "^4.23.13",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vite-svg-loader": "^5.1.3",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.11",
        "web-ext": "^10.6.0",
        "wxt": "^0.21.4"
    },
    "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
