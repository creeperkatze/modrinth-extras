{
    "name": "@creeperkatze/modrinth-extras",
    "version": "1.5.6",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox",
        "build": "wxt build",
        "build:firefox": "wxt build -b firefox",
        "zip": "wxt zip",
        "zip:firefox": "wxt zip -b firefox",
        "postinstall": "wxt prepare",
        "scripts": "node scripts/run.mjs",
        "intl:generate": "node scripts/run.mjs generate-locales",
        "intl:extract": "formatjs extract \"src/entrypoints/**/*.{vue,ts}\" --ignore \"src/**/*.d.ts\" --out-file src/locales/en-US/popup.json --preserve-whitespace && formatjs extract \"src/components/**/*.vue\" --ignore \"src/**/*.d.ts\" --out-file src/locales/en-US/components.json --preserve-whitespace",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "release:patch": "pnpm version patch && git push && git push --tags",
        "release:minor": "pnpm version minor && git push && git push --tags",
        "release:major": "pnpm version major && git push && git push --tags"
    },
    "dependencies": {
        "@lucide/vue": "^1.24.0",
        "@modrinth/api-client": "workspace:*",
        "@modrinth/assets": "workspace:*",
        "@modrinth/ui": "workspace:*",
        "@modrinth/utils": "workspace:*",
        "@wxt-dev/storage": "^1.2.8",
        "d3-force": "^3.0.0",
        "d3-selection": "^3.0.0",
        "d3-transition": "^3.0.1",
        "d3-zoom": "^3.0.0",
        "floating-vue": "^5.2.2",
        "posthog-js": "^1.399.2",
        "vue": "^3.5.39",
        "vue-i18n": "^11.4.6"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@formatjs/cli": "^6.16.13",
        "@modrinth/tooling-config": "workspace:*",
        "@tailwindcss/container-queries": "^0.1.1",
        "@tailwindcss/postcss": "^4.3.2",
        "@types/chrome": "^0.1.43",
        "@types/d3-force": "^3.0.10",
        "@types/d3-selection": "^3.0.11",
        "@types/d3-transition": "^3.0.9",
        "@types/d3-zoom": "^3.0.8",
        "@types/node": "^26.1.1",
        "@wxt-dev/module-vue": "^1.0.3",
        "autoprefixer": "^10.5.2",
        "eslint": "^10.7.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "eslint-plugin-vue": "^10.9.2",
        "globals": "^16.5.0",
        "sass-embedded": "^1.100.0",
        "tailwindcss": "^3.4.19",
        "tsx": "^4.23.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.63.0",
        "vite-svg-loader": "^5.1.1",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.7",
        "wxt": "^0.20.26"
    },
    "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8"
}
