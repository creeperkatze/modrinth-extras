{
    "name": "@creeperkatze/modrinth-extras",
    "version": "1.8.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox",
        "build": "wxt build",
        "build:firefox": "wxt build -b firefox",
        "zip": "wxt zip",
        "zip:firefox": "wxt zip -b firefox",
        "postinstall": "wxt prepare",
        "scripts": "node scripts/run.mjs",
        "intl:generate": "node scripts/run.mjs generate-locales",
        "intl:prune": "node scripts/run.mjs prune-locales",
        "intl:extract": "formatjs extract \"src/entrypoints/**/*.{vue,ts}\" --ignore \"src/**/*.d.ts\" --out-file src/locales/en-US/popup.json --preserve-whitespace && formatjs extract \"src/components/**/*.vue\" --ignore \"src/**/*.d.ts\" --out-file src/locales/en-US/components.json --preserve-whitespace",
        "typecheck": "vue-tsc --noEmit",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "release:patch": "pnpm version patch && git push && git push --tags",
        "release:minor": "pnpm version minor && git push && git push --tags",
        "release:major": "pnpm version major && git push && git push --tags"
    },
    "dependencies": {
        "@lucide/vue": "^1.62.0",
        "@modrinth/api-client": "workspace:*",
        "@modrinth/assets": "workspace:*",
        "@modrinth/ui": "workspace:*",
        "@modrinth/utils": "workspace:*",
        "@wxt-dev/analytics": "^0.5.8",
        "@wxt-dev/storage": "^1.3.0",
        "colord": "^2.10.0",
        "curseforge-js": "^1.1.5",
        "d3-force": "^3.0.0",
        "d3-selection": "^3.0.0",
        "d3-transition": "^3.0.1",
        "d3-zoom": "^3.0.0",
        "hangarmc-js": "^1.1.0",
        "moddex-js": "^2.0.1",
        "spiget-js": "^1.0.4",
        "vue": "^3.5.44",
        "vue-i18n": "^11.4.16"
    },
    "devDependencies": {
        "@formatjs/cli": "^6.16.36",
        "@modrinth/tooling-config": "workspace:*",
        "@tailwindcss/container-queries": "^0.1.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/chrome": "^0.3.6",
        "@types/d3-force": "^3.0.10",
        "@types/d3-selection": "^3.0.12",
        "@types/d3-transition": "^3.0.9",
        "@types/d3-zoom": "^3.0.9",
        "@types/node": "^26.6.5",
        "@wxt-dev/module-vue": "^1.0.3",
        "autoprefixer": "^10.6.2",
        "oxfmt": "^0.75.0",
        "oxlint": "^1.90.0",
        "sass-embedded": "^1.106.1",
        "tailwindcss": "^3.4.19",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "vite-svg-loader": "^5.1.3",
        "vue-tsc": "^3.3.13",
        "web-ext": "^10.8.0",
        "wxt": "^0.21.5"
    },
    "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
